{
  "name": "daily",
  "version": "1.0.0",
  "description": "A todo app with one card per day.",
  "license": "MIT",
  "author": {
    "name": "Poorya",
    "email": "poorya922@gmail.com"
  },
  "homepage": "https://github.com/pooryam92/daily",
  "repository": "github:pooryam92/daily",
  "main": "out/electron/main/index.js",
  "desktopName": "daily.desktop",
  "scripts": {
    "dev": "npm run build:main && concurrently -k -n vite,app \"vite\" \"wait-on tcp:5173 && electron . --dev\"",
    "build": "npm run build:main && vite build",
    "build:main": "tsc -p tsconfig.node.json",
    "start": "npm run build && electron .",
    "dist": "npm run build && electron-builder --publish never",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "check": "npm run typecheck && npm run lint && npm run test && prettier --check ."
  },
  "type": "commonjs",
  "devDependencies": {
    "@base-ui/react": "^1.8.0",
    "@dnd-kit/abstract": "0.5.0",
    "@dnd-kit/dom": "0.5.0",
    "@dnd-kit/react": "0.5.0",
    "@eslint/js": "^10.0.1",
    "@fontsource-variable/inter": "^5.3.0",
    "@types/node": "^24.13.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "electron": "^44.4.3",
    "electron-builder": "^26.15.3",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "lucide-react": "^1.47.0",
    "motion": "^13.4.0",
    "prettier": "^3.9.8",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sonner": "^2.0.8",
    "typescript": "~6.0",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.1",
    "wait-on": "^9.1.0",
    "wheel-gestures": "^2.3.0"
  },
  "private": true,
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
